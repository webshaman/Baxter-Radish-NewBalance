#!/usr/bin/env python3
"""Rebuild decks/index.html, the private list of every deck in this repo.

Usage:
  scripts/build-decks-index

A deck is any top-level folder with an index.html. Its name comes from the
<title>, and its date is when the folder's index.html was first committed.
Newest first, except PINNED decks, which always lead the list.
Run this after adding or renaming a deck, then commit decks/index.html.
"""
import html
import os
import re
import subprocess

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SKIP = {"decks"}
PINNED = {"template"}  # always listed first
SUFFIX = re.compile(r"\s*[—–-]\s*Baxter House( Music)?\s*$")


def git(*args):
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True).stdout.strip()


def deck_rows():
    rows = []
    for name in sorted(os.listdir(ROOT)):
        page = os.path.join(ROOT, name, "index.html")
        if name.startswith(".") or name in SKIP or not os.path.isfile(page):
            continue
        with open(page, encoding="utf-8") as f:
            m = re.search(r"<title>(.*?)</title>", f.read(), re.S)
        title = html.unescape(m.group(1).strip()) if m else name
        title = SUFFIX.sub("", title)
        created = git("log", "--diff-filter=A", "--format=%cs", "--", f"{name}/index.html").splitlines()
        rows.append((name, title, created[-1] if created else ""))
    rows.sort(key=lambda r: r[2], reverse=True)
    rows.sort(key=lambda r: r[0] not in PINNED)
    return rows


def render(rows):
    items = "\n".join(
        f'    <li><a href="/{n}/"><span class="name">{html.escape(t)}</span>'
        f'<span class="path">/{n}/</span><span class="date">{d}</span></a></li>'
        for n, t, d in rows
    )
    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>All Decks — Baxter House Music</title>
<link rel="icon" href="/volume/favicon-32.jpg" sizes="32x32">
<!-- Generated by scripts/build-decks-index. Edit the script, not this file. -->
<style>
:root{{--bg:#000;--fg:#fff;--dim:#9aa0a6;--line:rgba(255,255,255,.14);--hover:#1a1a1a}}
*{{box-sizing:border-box}}
body{{margin:0;background:var(--bg);color:var(--fg);
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;line-height:1.4}}
main{{max-width:900px;margin:0 auto;padding:72px 16px 96px}}
.kicker{{font-size:13px;letter-spacing:3px;text-transform:uppercase;color:var(--dim);font-weight:700;margin:0 0 10px}}
h1{{font-size:56px;line-height:1.02;letter-spacing:-1.2px;margin:0 0 40px;font-weight:800}}
ul{{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}}
li a{{display:grid;grid-template-columns:1fr auto 110px;gap:24px;align-items:baseline;
  padding:20px 12px;border-bottom:1px solid var(--line);color:inherit;text-decoration:none}}
li a:hover,li a:focus-visible{{background:var(--hover)}}
.name{{font-size:22px;font-weight:700}}
.path{{font-size:14px;color:var(--dim);font-family:ui-monospace,Menlo,monospace}}
.date{{font-size:14px;color:var(--dim);text-align:right;font-variant-numeric:tabular-nums}}
@media (max-width:640px){{
  main{{padding-top:48px}} h1{{font-size:38px;margin-bottom:28px}}
  li a{{grid-template-columns:1fr auto;gap:4px 16px}} .name{{font-size:19px;grid-column:1/-1}}
  .date{{text-align:right}}
}}
</style>
</head>
<body>
<main>
  <p class="kicker">Baxter House Music</p>
  <h1>All Decks</h1>
  <ul>
{items}
  </ul>
</main>
</body>
</html>
"""


if __name__ == "__main__":
    os.makedirs(os.path.join(ROOT, "decks"), exist_ok=True)
    rows = deck_rows()
    with open(os.path.join(ROOT, "decks", "index.html"), "w", encoding="utf-8") as f:
        f.write(render(rows))
    print(f"decks/index.html: {len(rows)} decks")
